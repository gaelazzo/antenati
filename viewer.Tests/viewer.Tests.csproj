<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Test del Viewer. viewer.csproj e' un progetto .NET Framework "vecchio stile" (resx, WebView2):
    va compilato con l'MSBuild di Visual Studio, non con "dotnet build". Comandi nel readme.md.
    I test "Online" (sito Antenati reale) sono [Explicit]: partono solo se richiesti per nome o categoria.
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <RootNamespace>viewer.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NUnit" Version="4.4.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.2.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gedcom.NET\GedcomParser\GedcomParser.csproj" />
    <ProjectReference Include="..\viewer\viewer.csproj" />
    <ProjectReference Include="..\Gedcom.NET\Gedcom\Gedcom.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
